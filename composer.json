{
  "name": "awalbros/portal-hub",
  "description": "Portal internal RS Awal Bros Botania",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "mpdf/mpdf": "^8.3",
    "openspout/openspout": "^4.28"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": { "psr-4": { "App\\": "app/" }, "files": ["app/Helpers/functions.php"] },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "db:check": "@php bin/db-check.php",
    "db:migrate": "@php bin/migrate.php",
    "admin:create": ["Composer\\Config::disableProcessTimeout", "@php bin/create-admin.php"],
    "test": "@php vendor/bin/phpunit"
  },
  "config": { "sort-packages": true, "platform": { "php": "8.2.12" } }
}
