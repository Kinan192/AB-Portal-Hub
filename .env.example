# Copy to .env and fill in local values. Never commit .env.
APP_ENV=local
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abportal_db
DB_USERNAME=
DB_PASSWORD=
DB_TIMEZONE=+07:00

# Development-only free login: any non-empty username and password is accepted,
# but only when APP_ENV=local AND AUTH_DEV_BYPASS=true. Otherwise login checks the users table.
# TODO(auth): HAPUS/NONAKTIFKAN sebelum dipakai di server RS.
AUTH_DEV_BYPASS=false