# Installed dependencies
/node_modules/
/vendor/

# Environment secrets and Composer credentials
.env
.env.*
!.env.example
/auth.json

# Runtime data; retain directory placeholders
/storage/logs/*
/storage/sessions/*
/storage/app/*
!/storage/logs/.gitkeep
!/storage/sessions/.gitkeep
!/storage/app/.gitkeep

# Logs and editor temporary files
*.log
npm-debug.log*
*.swp
*.swo
*~

# Personal IDE workspaces and operating-system metadata
/.idea/
/*.code-workspace
.DS_Store
Thumbs.db
[Dd]esktop.ini

# Keep public assets, .htaccess, lockfiles, and SQL migrations in version control.

# PHPUnit cache
/.phpunit.result.cache
/.phpunit.cache/
