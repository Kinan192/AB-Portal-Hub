# Copy to .env and fill in local values. Never commit .env.
# APP_ENV: local on a developer PC; anything else (e.g. production) on the hospital server.
APP_ENV=local
# Address of the portal without a trailing slash, e.g. https://portal-it.rs.local. Empty = found automatically:
# the site root, or the folder when the project sits in XAMPP htdocs (http://localhost/abportal).
APP_URL=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abportal_db
DB_USERNAME=
DB_PASSWORD=
# Times are stored in UTC; DB_TIMEZONE is no longer used.

# Name under "Diketahui oleh, Kepala Instalasi IT" in PDF exports and prints (empty = a blank line to sign on).
REPORT_HEAD_OF_IT_NAME=

# Backups (php bin/backup.php, nightly at 01:00; restore with php bin/restore.php). See README "Backup otomatis".
# BACKUP_DIR: outside the project folder (empty = a folder AB-Portal-Hub-backups next to the project).
BACKUP_DIR=
# Second copy on another machine or NAS, e.g. \\nas\backup\abportal (empty = none; PRD NFR-5 asks for one).
BACKUP_COPY_DIR=
# Number of backup sets kept in each location.
BACKUP_KEEP=30
# Optional AES-256 key (php bin/backup.php key). Keep a copy OUTSIDE this server: without it, backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Folder of mysqldump/mysql, e.g. C:\xampp\mysql\bin (empty = found on PATH).
MYSQL_BIN_DIR=
# Application error logs (storage/logs/app-YYYY-MM-DD.log) older than this many days are removed by the nightly backup.
LOG_KEEP_DAYS=90

# Minimum password length (at least 8; default 12).
PASSWORD_MIN_LENGTH=8
